{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"java.configuration.updateBuildConfiguration": "automatic",
		"java.symbols.includeSourceMethodDeclarations": true,
		"java.test.config": {
			"vmArgs": [
				"-Xshare:off",
				"-XX:+EnableDynamicAgentLoading",
				"--add-opens",
				"java.base/java.util=ALL-UNNAMED",
				"--enable-native-access=ALL-UNNAMED"
			]
		},
		"maven.executable.path": "/usr/local/bin/mvn",
		"maven.terminal.favorites": [
			{
				"alias": "Build Package (Skip Tests)",
				"command": "clean package -DskipTests"
			},
			{
				"alias": "Build, Test, Install",
				"command": "clean install"
			},
			{
				"alias": "Spotless apply format",
				"command": "spotless:apply"
			},
		],
		"emeraldwalk.runonsave": {
			"commands": [
				{
					"match": "\\.java$",
					"cmd": "mvn --batch-mode --quiet spotless:apply -DspotlessFiles=.*${relativeFile}",
					"message": "Applying Spotless format to ${fileBasename}",
					"showElapsed": true,
				},
			]
		},
		"xml.format.maxLineWidth": 120,
	}
}
